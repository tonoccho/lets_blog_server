{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "playwright:install": "playwright install",
    "test:e2e": "rm -rf .features-gen && bddgen && playwright test",
    "test:e2e:ui": "rm -rf .features-gen && bddgen && playwright test --ui",
    "test:e2e:debug": "rm -rf .features-gen && bddgen && playwright test --debug",
    "test:at": "rm -rf .features-gen && bddgen && playwright test --project=at-destructive",
    "test:at:fast": "rm -rf .features-gen && bddgen && playwright test --project=at-main --grep-invert \"@slow\"",
    "test:at:ui": "rm -rf .features-gen && bddgen && playwright test --project=at-destructive --ui",
    "test:at:clean": "rm -rf .features-gen && bddgen && ACCEPTANCE_RESET=1 playwright test --project=at-destructive",
    "test:a11y": "rm -rf .features-gen && bddgen && playwright test --project=at-destructive --grep \"@a11y\"",
    "generate:api-client": "cd ../.. && ./scripts/generate-api-client.sh"
  },
  "dependencies": {
    "jose": "^6.2.10",
    "lucide-react": "^1.27.0",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@orval/core": "8.27.0",
    "@orval/fetch": "8.27.0",
    "@playwright/test": "^1.40.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-playwright": "^2.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "playwright-bdd": "^9.2.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  }
}
