# 注: 通常は `docker compose up -d` の web サービスが自動起動するため、このファイルは不要。
# ホスト上で `npm run dev` を直接起動する代替ワークフロー用(docs/setup.md参照)。

# Web(BFF)のサーバーサイドAPI呼び出し先。単一入口であるgatewayに一本化している(issue #584)。
# ホスト実行時はgatewayのポートが非公開のため、リバースプロキシ(nginx)経由で到達する
# (nginxの location /api/ が gateway:8080 へ中継する)。
LETS_BLOG_GATEWAY_URL=https://localhost

# Auth.js(NextAuth)のセッション署名鍵。生成例: openssl rand -hex 32
NEXTAUTH_SECRET=changeme_nextauth_secret
NEXTAUTH_URL=https://localhost

# Keycloakのletsblog-webクライアントのシークレット(#564)。
# ルートの.envのKEYCLOAK_WEB_CLIENT_SECRETと同じ値を設定する
# (infra/keycloak/realm-export.jsonで定義済みの値と一致させる必要がある)。
KEYCLOAK_WEB_CLIENT_SECRET=changeme_letsblog_web_secret

# 開発サーバー(Node.js)からhttps://localhostの自己署名証明書を信頼するために必要
# (未設定だとproxy.ts/apiClient.tsからのAPI呼び出しがUNABLE_TO_VERIFY_LEAF_SIGNATUREで失敗する)
# 生成方法は scripts/generate-certs.sh を参照
NODE_EXTRA_CA_CERTS=../../certs/localhost.crt
