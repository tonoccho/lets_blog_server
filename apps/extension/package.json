{
  "name": "letsblog-vscode",
  "displayName": "Let's Blog",
  "description": "Markdownで執筆した記事を仲介APIサーバー経由でWordPressへ投稿するVSCode拡張",
  "version": "0.4.3-DEVELOP",
  "publisher": "letsblog",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "letsBlog.createArticle",
        "title": "Let's Blog: Create Article"
      },
      {
        "command": "letsBlog.createArticleWithoutAi",
        "title": "Let's Blog: Create Article (No AI)"
      },
      {
        "command": "letsBlog.login",
        "title": "Let's Blog: Login"
      },
      {
        "command": "letsBlog.logout",
        "title": "Let's Blog: Logout"
      },
      {
        "command": "letsBlog.publish",
        "title": "Let's Blog: Publish"
      },
      {
        "command": "letsBlog.deletePost",
        "title": "Let's Blog: Delete Post"
      },
      {
        "command": "letsBlog.selectSite",
        "title": "Let's Blog: Select Site"
      },
      {
        "command": "letsBlog.askAi",
        "title": "Let's Blog: Ask AI (Draft/Proofread/Summarize)"
      },
      {
        "command": "letsBlog.suggestTags",
        "title": "Let's Blog: Suggest Tags"
      },
      {
        "command": "letsBlog.switchAiProvider",
        "title": "Let's Blog: AIプロバイダーを切り替える"
      },
      {
        "command": "letsBlog.generateImage",
        "title": "Let's Blog: Generate Image"
      },
      {
        "command": "letsBlog.generateSection",
        "title": "Let's Blog: Generate Section"
      },
      {
        "command": "letsBlog.askAiSearch",
        "title": "Let's Blog: Ask AI (Web Search)"
      },
      {
        "command": "letsBlog.selectProject",
        "title": "Let's Blog: Select Project"
      },
      {
        "command": "letsBlog.planArticle",
        "title": "Let's Blog: Plan Article"
      },
      {
        "command": "letsBlog.previewArticle",
        "title": "Let's Blog: Preview Article"
      },
      {
        "command": "letsBlog.previewDevTools",
        "title": "Let's Blog: Open Preview DevTools"
      },
      {
        "command": "letsBlog.schedulePublication",
        "title": "Let's Blog: Schedule Publication"
      },
      {
        "command": "letsBlog.imageGallery",
        "title": "Let's Blog: Image Gallery"
      },
      {
        "command": "letsBlog.addNewDiagram",
        "title": "Let's Blog: Add New Diagram"
      },
      {
        "command": "letsBlog.editDiagram",
        "title": "Let's Blog: Edit Diagram"
      },
      {
        "command": "letsBlog.diagramGallery",
        "title": "Let's Blog: Diagram Gallery"
      },
      {
        "command": "letsBlog.pasteSmartCard",
        "title": "Let's Blog: Paste as Smart Card (Blog Card / Amazon)"
      },
      {
        "command": "letsBlog.pasteAsLink",
        "title": "Let's Blog: Paste as Link"
      },
      {
        "command": "letsBlog.proofreadNow",
        "title": "Let's Blog: 校正チェックを今すぐ実行(5ステップレビュー)"
      },
      {
        "command": "letsBlog.reviewChecklist",
        "title": "Let's Blog: 指摘チェックリストを表示"
      }
    ],
    "keybindings": [
      {
        "command": "letsBlog.pasteSmartCard",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && !editorReadonly && resourceLangId == markdown"
      },
      {
        "command": "letsBlog.pasteAsLink",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "editorTextFocus && !editorReadonly && resourceLangId == markdown"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "letsBlog.previewArticle",
          "when": "editorTextFocus && resourceLangId == markdown",
          "group": "letsBlog@0"
        },
        {
          "command": "letsBlog.generateImage",
          "when": "editorTextFocus && resourceLangId == markdown",
          "group": "letsBlog@1"
        },
        {
          "command": "letsBlog.generateSection",
          "when": "editorTextFocus && resourceLangId == markdown",
          "group": "letsBlog@2"
        },
        {
          "command": "letsBlog.imageGallery",
          "when": "editorTextFocus && resourceLangId == markdown",
          "group": "letsBlog@3"
        },
        {
          "command": "letsBlog.addNewDiagram",
          "when": "editorTextFocus && resourceLangId == markdown",
          "group": "letsBlog@4"
        },
        {
          "command": "letsBlog.editDiagram",
          "when": "editorTextFocus && resourceLangId == markdown && letsBlog.cursorOnDiagram",
          "group": "letsBlog@5"
        },
        {
          "command": "letsBlog.diagramGallery",
          "when": "editorTextFocus && resourceLangId == markdown",
          "group": "letsBlog@6"
        },
        {
          "command": "letsBlog.askAiSearch",
          "when": "editorTextFocus && resourceLangId == markdown",
          "group": "letsBlog@7"
        },
        {
          "command": "letsBlog.suggestTags",
          "when": "editorTextFocus && resourceLangId == markdown",
          "group": "letsBlog@8"
        },
        {
          "command": "letsBlog.proofreadNow",
          "when": "editorTextFocus && resourceLangId == markdown",
          "group": "letsBlog@9"
        },
        {
          "command": "letsBlog.reviewChecklist",
          "when": "editorTextFocus && resourceLangId == markdown",
          "group": "letsBlog@10"
        }
      ]
    },
    "configuration": {
      "title": "Let's Blog",
      "properties": {
        "letsBlog.serverUrl": {
          "type": "string",
          "default": "https://localhost",
          "description": "Let's Blogサーバーのリバースプロキシ(nginx)の公開URL(自己署名証明書を既定で使用)。API呼び出し(/api/**)はすべてこのURL経由でAPIゲートウェイへ中継され、ゲートウェイが各サービスへ振り分けます。ログイン(Keycloak)とダイアグラム編集(draw.io)も同じURLを使います。"
        },
        "letsBlog.allowInsecureTls": {
          "type": "boolean",
          "default": false,
          "description": "letsBlog.serverUrlへのHTTPS接続で自己署名証明書を許容する(証明書検証をスキップする)。既定はfalse(検証を行う)。自己署名証明書のローカル環境(https://localhost等)へ接続する場合のみ、接続先が信頼できることを確認したうえでtrueに設定してください。trueにすると中間者攻撃を検出できなくなります。"
        },
        "letsBlog.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "デバッグログを出力パネル「Let's Blog」へ出力する。不具合の調査時に有効化してください。"
        },
        "letsBlog.requestTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "description": "APIリクエストのタイムアウト時間(ミリ秒)。AI生成など時間のかかる処理でタイムアウトする場合は延ばしてください。記事公開と画像生成は、この値がより短くても処理に必要な時間(画像生成は要求枚数から算出。最大3600秒)を確保します。"
        },
        "letsBlog.aiProvider": {
          "type": "string",
          "enum": ["", "OLLAMA", "OPENAI", "CLAUDE"],
          "enumDescriptions": [
            "サーバー(プロジェクト/システム設定)の既定値を使用",
            "Ollama",
            "OpenAI (ChatGPT)",
            "Claude (Anthropic)"
          ],
          "default": "",
          "description": "文章提案AIに使うプロバイダー。「Let's Blog: AIプロバイダーを切り替える」コマンドや各AI生成画面のメニューからも切り替えられます。空欄はサーバー側の既定値(プロジェクト設定、未設定ならシステム設定)を使用します。"
        },
        "letsBlog.proofreadEnabled": {
          "type": "boolean",
          "default": false,
          "deprecationMessage": "この設定は廃止されました。本文のAIレビューは自動実行されなくなり、「Let's Blog: 校正チェックを今すぐ実行」コマンドでのみ実行されます。設定は削除して構いません。",
          "description": "(廃止)本文のAI校正の自動実行は廃止されました。"
        },
        "letsBlog.proofreadDebounceMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "deprecationMessage": "この設定は廃止されました。本文のAIレビューの自動実行(デバウンス)は無くなり、値は使われません。設定は削除して構いません。",
          "description": "(廃止)本文のAI校正の自動実行は廃止されたため、この値は使われません。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "generate:api-client": "cd ../.. && ./scripts/generate-api-client.sh",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:at": "jest -c e2e/jest.config.js",
    "test:at:fast": "AT_EXCLUDE_TAGS=@slow,@destructive jest -c e2e/jest.config.js"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "zod": "^4.4.3"
  }
}
