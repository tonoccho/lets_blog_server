# Env / secrets
.env

# DB/Keycloakバックアップダンプ(実データを含むためコミット対象外)
backups/

# Claude Code セッション固有のランタイム状態(CLAUDE.md 等の規約ファイルはコミット対象)
.claude/scheduled_tasks.lock

# Java / Gradle
.gradle/
build/
bin/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Node
node_modules/
web/.next/
web/dist/
web/.env.local
npm-debug.log*

# VSCode extension
extension/out/
extension/coverage/
extension/dist/
extension/*.vsix

# IDE
.idea/
*.iml

# OS
.DS_Store

# Docker volumes data dumps (if any local bind mounts used)
docker-data/

# リバースプロキシ用TLS証明書(scripts/generate-certs.sh で生成、秘密鍵のためコミットしない)
certs/
