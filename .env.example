# リバースプロキシ(nginx)がhttps://localhostを終端するための自己署名証明書。
# `docker compose up -d` の前に以下を実行してください(初回のみ)
#   bash scripts/generate-certs.sh

# MySQL
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=lets_blog
MYSQL_USER=lbs_app
MYSQL_PASSWORD=changeme_app

# API server
# クライアント(VSCode拡張/Webフロント)がヘッダ `X-API-Key` に付与する固定キー
SERVER_API_KEY=changeme_api_key

# Web管理画面(Next.js/Auth.js)のセッション署名鍵。生成例: openssl rand -hex 32
NEXTAUTH_SECRET=changeme_nextauth_secret

# WordPressアプリケーションパスワード等を暗号化するための鍵(Base64エンコードされた32バイト値, AES-256-GCM用)
# 生成例: openssl rand -base64 32
APP_ENCRYPTION_KEY=changeme_base64_32byte_key

# ComfyUI(NVIDIA GPU / CUDA 13系向け。CPU機はyanwk/comfyui-boot:cpu、AMD機はrocmタグ等に変更)
COMFYUI_IMAGE=yanwk/comfyui-boot:cu130-slim

# Ollama(下書き/校正/要約支援・タグ提案に使用するモデル。事前に `docker exec lbs-ollama ollama pull <model>` が必要)
OLLAMA_MODEL=qwen2.5:7b-instruct

# ComfyUI(画像生成に使用するチェックポイント。comfyui_modelsは名前付きボリュームのため
# `docker cp <file> lbs-comfyui:/root/ComfyUI/models/checkpoints/` での事前配置が必要)
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors

# パスワード再設定メールの送信元アドレス・Webフロントの公開URL(メール内リンク生成に使用)
APP_MAIL_FROM=noreply@letsblog.example.com
APP_WEB_BASE_URL=https://localhost

# 本番SMTP設定(SPRING_PROFILES_ACTIVE=prod で application-prod.yml を有効化した場合のみ使用。
# 開発環境ではmailhogを使うため不要)
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=changeme_smtp_password
# MAIL_FROM_ADDRESS=noreply@example.com
