# リバースプロキシ(nginx)がhttps://localhostを終端するための自己署名証明書。
# `docker compose up -d` の前に以下を実行してください(初回のみ)
#   bash scripts/generate-certs.sh

# MySQL (Let's Blog用)
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=lets_blog
MYSQL_USER=lbs_app
MYSQL_PASSWORD=changeme_app

# Penpot configuration
# Master key for Penpot (512-bit base64 encoded). Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=changeme_penpot_secret_key_512bit_base64
PENPOT_VERSION=2.16

# Penpot service account(APIサーバーがカスタムタグのAIデザイン生成時に自動作成するファイル用。
# 未作成の場合、初回呼び出し時にAPIサーバーが自動登録する)
PENPOT_SERVICE_EMAIL=lbs-service@letsblog.local
PENPOT_SERVICE_PASSWORD=changeme_penpot_service_password

# ブラウザから開けるPenpotの公開URL(PENPOT_BASE_URLはコンテナ間通信専用の内部URLのため、
# 生成されるハンドオフリンクにはこちらを使用する。本番でリバースプロキシ配下に置く場合はそのURLに変更)
PENPOT_PUBLIC_URL=http://localhost:9001

# Penpot (デザイン・プロトタイピングツール)
PENPOT_VERSION=2.16
PENPOT_SECRET_KEY=changeme_penpot_secret_key

# MCP Server (Design AI Service)
MCP_LOG_LEVEL=info

# Web管理画面(Next.js/Auth.js)のセッション署名鍵。生成例: openssl rand -hex 32
NEXTAUTH_SECRET=changeme_nextauth_secret

# WordPressアプリケーションパスワード等を暗号化するための鍵(Base64エンコードされた32バイト値, AES-256-GCM用)
# 生成例: openssl rand -base64 32
APP_ENCRYPTION_KEY=changeme_base64_32byte_key

# ComfyUI(NVIDIA GPU / CUDA 13系向け。CPU機はyanwk/comfyui-boot:cpu、AMD機はrocmタグ等に変更)
COMFYUI_IMAGE=yanwk/comfyui-boot:cu130-slim

# 外部LLMサービス(OpenAI互換のChat Completions API)。下書き/校正/要約支援・タグ提案・記事プランニングに使用。
# OpenAI以外にもGroq/OpenRouter等のOpenAI互換エンドポイントに変更可能(LLM_BASE_URLを差し替える)。
LLM_API_KEY=changeme_llm_api_key
LLM_MODEL=gpt-4o-mini

# ComfyUI(画像生成に使用するチェックポイント。comfyui_modelsは名前付きボリュームのため
# `docker cp <file> lbs-comfyui:/root/ComfyUI/models/checkpoints/` での事前配置が必要)
# Phase14以降はプロジェクト画面からのURL指定インストールにも対応(apiコンテナにも同ボリュームをマウント)
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors

# Brave Search API(壁打ちチャットのAI応答生成前に必ずWeb検索を行うために使用)
# https://api.search.brave.com/ でAPIキーを取得
BRAVE_SEARCH_API_KEY=changeme_brave_search_api_key

# Google AdSense連携(issue #387)。Google Cloud ConsoleでOAuthクライアント(ウェブアプリケーション)を
# プロジェクトごとに発行し、承認済みのリダイレクトURIに `${NEXTAUTH_URL}/connect/adsense/callback` を
# 登録する。クライアントID/シークレットはプロジェクト詳細画面から設定する(issue #407、環境変数はない)。

# パスワード再設定メールの送信元アドレス・Webフロントの公開URL(メール内リンク生成に使用)
APP_MAIL_FROM=noreply@letsblog.example.com
APP_WEB_BASE_URL=https://localhost

# WordPress自動プロビジョニング用の内部共有シークレット(Spring Boot API ↔ wordpress コンテナ間、nginxには非公開)
# 生成例: openssl rand -hex 32
WP_PROVISION_TOKEN=changeme_wp_provision_token

# 外部メールサービス(SendGrid/Resend/AWS SES等)のSMTP接続設定。
# メール送信(パスワード再設定等)に使用するため必須。
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=changeme_smtp_password
