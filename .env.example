# タイムゾーン(#1257): このシステムが内部で扱う時刻はすべてUTC。TZ はここで設定しない。
# docker-compose.yml が全コンテナへ TZ=UTC を、MySQL へ --default-time-zone=+00:00 を固定しており、
# ホストのTZ(例: Pacific/Auckland)は影響しない。ホスト上の ./gradlew test と npm run test も
# UTC で動く(build.gradle / apps/web/jest.config.ts)。表示時のTZは閲覧者のブラウザに従う。
# 新しいサービスを足すときは environment に TZ: UTC を入れる(scripts/test_compose_timezone.py が検査)。

# リバースプロキシ(nginx)がhttps://localhostを終端するための自己署名証明書。
# `docker compose up -d` の前に以下を実行してください(初回のみ)
#   bash scripts/generate-certs.sh

# MySQL (Let's Blog用)
# MYSQL_DATABASE(分割前の単一スキーマ lets_blog)は issue #785 で撤去した。
# 各サービスは専用スキーマ lbs_*(ADR-0004)を使い、それぞれのパスワードは下の LBS_*_DB_PASSWORD。
# MYSQL_USER / MYSQL_PASSWORD は wordpress(WORDPRESS_DB_USER)が使う。
# phpMyAdmin(https://localhost/phpmyadmin/)へはコンテナに資格情報を渡していない(#978)。
# 自動ログインさせると URL に到達できる者が誰でも全DBを操作できてしまうため、
# 運用者がログイン画面でこの MYSQL_USER / MYSQL_PASSWORD を入力してログインする。
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_USER=lbs_app
MYSQL_PASSWORD=changeme_app

# サービス別MySQLスキーマ(#570, ADR-0004)。同一MySQLインスタンス内でサービスごとに
# スキーマと専用ユーザーを分離する(infra/mysql/init/01-create-service-schemas.sh が初回起動時に作成)。
# 各サービスユーザーは自分のスキーマにしかアクセスできない。現時点ではどのサービスも
# まだこれらのスキーマを使用していない(将来のサービス抽出Issueで使用開始する)。
# 注意(#667): 既にMySQLのデータボリュームが初期化済みの環境でここの値を変更しても
# MySQL側のユーザーパスワードは自動更新されない。反映手順はdocs/SERVICE_SCHEMA_MIGRATION.md
# の「.envのDBパスワードを変更した場合」を参照。
LBS_IDENTITY_DB_PASSWORD=changeme_identity
LBS_PROJECT_DB_PASSWORD=changeme_project
LBS_CONTENT_DB_PASSWORD=changeme_content
LBS_MEDIA_DB_PASSWORD=changeme_media
LBS_AI_DB_PASSWORD=changeme_ai
LBS_PUBLISHING_DB_PASSWORD=changeme_publishing
LBS_ANALYTICS_DB_PASSWORD=changeme_analytics
LBS_PLATFORM_DB_PASSWORD=changeme_platform
LBS_LOG_DB_PASSWORD=changeme_log
# platform-serviceのBackupServiceが全MySQLスキーマを横断してバックアップ/リストアするための
# 専用ユーザー(issue #694、C10-2)。01-create-service-schemas.shが上記の各スキーマ限定の権限のみを
# 付与する(MySQL rootクレデンシャルは使わない)。
LBS_BACKUP_DB_PASSWORD=changeme_backup

# RabbitMQ(ログメッセージキューイング用。issue #466)。apiサーバーがエラーログ/操作ログ/監査ログを
# 発行し、log-writerサービスがキューから受信してDBへ記録する。
RABBITMQ_USER=lbs_app
RABBITMQ_PASSWORD=changeme_rabbitmq

# Keycloak(認証基盤。ADR-0002, #559)。管理者初期認証情報とKeycloak専用PostgreSQLのパスワード。
# realm(letsblog)/クライアント/ロールの定義は infra/keycloak/realm-export.json をGit管理し、
# 起動時に自動importする(GUIでの手作業設定はしない)。
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_keycloak_admin
KEYCLOAK_DB_PASSWORD=changeme_keycloak_db
#
# 以下2つのクライアントシークレットは infra/keycloak/realm-export.json の `secret` と
# **必ず一致させること**。realm-export.json が正で、Keycloak は起動時にその値で realm を import する。
# 食い違うとクライアント認証が invalid_client で失敗し、
#   - web(letsblog-web)はトークン交換できず **ログインできない**
#   - identity-service(letsblog-services)は Admin API を呼べずユーザー同期(#562)が失敗する
# という形で現れる。原因が .env と realm-export の不一致であることは追いにくい(issue #793)。
#
# 既定値(dev-only-*-change-me)は公開リポジトリに載っているため、**誰でも知り得る**。
# `setup.sh` の初回構築はここをランダム値に置き換え、docker-compose.yml が同じ値を keycloak
# コンテナへ渡して realm-export.json の `${VAR:既定値}` に import させる(#1551)。
# 手で `cp .env.example .env` した環境は既定値のままになり、scripts/check-env.sh が警告する。
# 既に稼働している環境の値を変える手順(Keycloak 側の secret も揃える)は
# docs/KEYCLOAK_CLIENT_SECRET_ROTATION.md。.env だけ書き換えると invalid_client になる。
#
# identity-serviceがKeycloak Admin APIを呼ぶためのサービスアカウント(letsblog-services)のシークレット(#562)。
KEYCLOAK_SERVICES_CLIENT_SECRET=dev-only-letsblog-services-secret-change-me
# Web(Next.js/Auth.js)がKeycloakのletsblog-webクライアント(confidential client)として
# トークン交換する際のクライアントシークレット(#564)。
KEYCLOAK_WEB_CLIENT_SECRET=dev-only-letsblog-web-secret-change-me

# MCP Server (Design AI Service)
MCP_LOG_LEVEL=info

# Web管理画面(Next.js/Auth.js)のセッション署名鍵。生成例: openssl rand -hex 32
NEXTAUTH_SECRET=changeme_nextauth_secret

# サイトのSSH秘密鍵・APIキー等の秘匿情報を暗号化するための鍵(Base64エンコードされた32バイト値, AES-256-GCM用)
# 生成例: openssl rand -base64 32
# 以下はダミー値(Base64として有効・32バイトだが、明らかに鍵ではない文字列)。
# 未変更のままだと check-env.sh が失敗する(issue #1058)。
APP_ENCRYPTION_KEY=UkVQTEFDRV9XSVRIX09QRU5TU0xfUkFORF9CNjRfMzI=

# ComfyUI は同梱しない(issue #1746)。GPU 付きの別 PC(GPU PC)で ComfyUI を起動し、管理画面の
# システム設定(またはプロジェクト設定)に URL(例: http://192.168.1.71:8188)を入れて接続する。
# 手順と既存環境の移行は docs/EXTERNAL_COMFYUI.md を参照。

# 演算デバイス(GPU / CPU)を管理画面から切り替える機能は廃止した(issue #1744)。GPU で動かすか CPU で動かすかは、
# Ollama / ComfyUI を動かす PC 側の起動方法で決める。

# 周辺ツールのオプトイン起動(issue #1741)。既定の `docker compose up -d` / ./startup.sh では
# 次の3サービスのコンテナを作らない(アイドル時に計0.4〜0.9GB)。必要なものだけカンマで列挙する
# (例: COMPOSE_PROFILES=diagram,db-tools)。
#   diagram  … PlantUML(図のプレビューと公開)と draw.io(/drawio/)
#   db-tools … phpMyAdmin(/phpmyadmin/)
# 無効のとき: /drawio/ と /phpmyadmin/ は 502 Bad Gateway、PlantUML 図のプレビュー・公開はレンダリング
# 失敗のエラー(400)になり、管理画面「連携サービスの状況」の PlantUML は「エラー」になる。
# 一回だけ起動するなら `docker compose --profile diagram up -d` でもよい。
# 受け入れテスト環境(scripts/rebuild-acceptance-env.sh)はこの設定に関わらず両方を有効にする。
# COMPOSE_PROFILES=diagram,db-tools

# AIプロバイダー(OLLAMA / OPENAI / CLAUDE)。既定はローカルのOllamaで、外部LLMのAPIキーを
# 設定しなくてもAI執筆支援が動く(issue #1086)。システム設定画面(DB)で設定済みの場合は
# そちらが優先される。
LLM_PROVIDER=OLLAMA

# Ollama(issue #1086)。Let's Blog のスタックは Ollama を含まない(#1745)。GPU を持つ別 PC で
# Ollama を動かし、その URL(例: http://192.168.1.71:11434/v1)をシステム設定画面かプロジェクト設定で
# 入れて接続する。手順は docs/EXTERNAL_OLLAMA.md。
# 接続先は環境変数では決めない(issue #1567。LLM_OLLAMA_BASE_URL は廃止した)。未設定のまま Ollama を
# 使うと「Ollama の接続先が設定されていません」というエラーになる(OpenAI互換エンドポイントの /v1 まで含めること)。
# Ollama の既定モデル名(システム設定で変えられる。GPU PC 側で `ollama pull` しておくこと)。
LLM_OLLAMA_MODEL=qwen2.5:7b-instruct

# 外部LLMサービス(OpenAI互換のChat Completions API)。LLM_PROVIDER=OPENAI のときに使う。
# ChatGPTの接続先は常に https://api.openai.com/v1 で、環境変数・システム設定では変えられない(issue #1569)。
# ChatGPT / ClaudeのAPIキーはシステム設定・環境変数では持たず、プロジェクトごとに
# AI・アセットタブで設定する(issue #1568)。
LLM_MODEL=gpt-4o-mini
# LLM_AVAILABLE_MODELS: システム設定画面のモデル選択に出す候補(カンマ区切り、LLM_PROVIDER=OPENAI用)。
LLM_AVAILABLE_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini
# LLM呼び出し全体(下書き/校正/要約支援等)のタイムアウト秒数。
LLM_REQUEST_TIMEOUT_SECONDS=120

# LLM_PROVIDER=CLAUDE のときに使うモデル名。
LLM_CLAUDE_MODEL=claude-3-5-haiku-20241022

# ChatGPT画像生成のAPIキーはシステム設定・環境変数では持たず、プロジェクトごとに設定する(issue #1521)。
# 接続先は常にOpenAIで、設定項目は無い(issue #1569)。

# ComfyUI で画像生成に使うチェックポイントの既定名(プロジェクトで選んでいないときの既定値)。
# ファイルの実体は GPU PC の ComfyUI の models/checkpoints/ に置く(Let's Blog の画面・API からの
# 導入・削除は無い。issue #1746、docs/EXTERNAL_COMFYUI.md)。
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors

# 不適切コンテンツフィルタ(blockSexualContent等、既定ON)が有効なカテゴリで、
# ComfyUI経路の画像生成negative promptへ自動連結する安全側の抑制語(issue #1085)。
# ChatGPT経路はnegative promptを送れないため連結されない(プロバイダー側モデレーションに依存)。
# 空文字にするとそのカテゴリは連結されない。
SAFETY_NEGATIVE_PROMPT_SEXUAL="nsfw, nude, naked, nudity, explicit, sexual, lewd, erotic, underwear, lingerie, cleavage"
SAFETY_NEGATIVE_PROMPT_VIOLENT="gore, gory, mutilated, dismembered, corpse, blood, violence, decapitated"
SAFETY_NEGATIVE_PROMPT_DISCRIMINATORY="nazi symbol, hate symbol, racist imagery, offensive stereotype"

# Brave Search API(壁打ちチャットのAI応答生成前に必ずWeb検索を行うために使用)
# https://api.search.brave.com/ でAPIキーを取得
# 利用者自身が用意する外部の値のため、setup.sh は生成しない(空のまま)。使う場合は手動で設定する。
BRAVE_SEARCH_API_KEY=

# Google AdSense連携(issue #387)。Google Cloud ConsoleでOAuthクライアント(ウェブアプリケーション)を
# プロジェクトごとに発行し、承認済みのリダイレクトURIに `${NEXTAUTH_URL}/connect/adsense/callback` を
# 登録する。クライアントID/シークレットはプロジェクト詳細画面から設定する(issue #407、環境変数はない)。

# パスワード再設定メールの送信元アドレス・Webフロントの公開URL(メール内リンク生成に使用)
APP_MAIL_FROM=noreply@letsblog.example.com
APP_WEB_BASE_URL=https://localhost

# WordPress自動プロビジョニング用の内部共有シークレット(Spring Boot API ↔ wordpress コンテナ間、nginxには非公開)
# 生成例: openssl rand -hex 32
WP_PROVISION_TOKEN=changeme_wp_provision_token

# 外部メールサービス(SendGrid/Resend/AWS SES等)のSMTP接続設定。
# メール送信(パスワード再設定等)に使用するため必須。
# MAIL_PASSWORDは利用者自身が用意する外部の値のため、setup.sh は生成しない(空のまま)。
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=

# 画像生成/アップロードのレート制限(一定期間あたりのリクエスト数上限。gatewayのRate Limiterが使用)。
UPLOAD_RATE_LIMIT_REQUESTS=10

# 各サイトの管理画面へのリンクに使う管理画面パスのグローバル既定値(同一オリジンの相対パス。
# システム設定画面のDB値が優先される)。サイトごとの上書きは別機能。
SITE_ADMIN_PATH=wp-admin

# COMPOSE_PROJECT_NAME / KEYCLOAK_VERSION / DRAWIO_IMAGE は docker-compose.yml が
# ${VAR:-既定値} で参照するが、ここには意図的に追記していない(issue #982)。
# いずれもイメージタグ/バージョン固定・プロジェクト名で、通常の利用者が触る設定ではなく、
# 変更が必要な運用者は docker-compose.yml を直接見て上書きすればよいため。
