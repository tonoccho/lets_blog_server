# リバースプロキシ(nginx)経由の仲介APIサーバーURL(直接ポート8080は非公開のため使用不可)
LETS_BLOG_API_URL=https://localhost
LETS_BLOG_API_KEY=dev_local_api_key

# Auth.js(NextAuth)のセッション署名鍵。生成例: openssl rand -hex 32
NEXTAUTH_SECRET=changeme_nextauth_secret
NEXTAUTH_URL=https://localhost

# 開発サーバー(Node.js)からhttps://localhostの自己署名証明書を信頼するために必要
# (未設定だとproxy.ts/apiClient.tsからのAPI呼び出しがUNABLE_TO_VERIFY_LEAF_SIGNATUREで失敗する)
# 生成方法は scripts/generate-certs.sh を参照
NODE_EXTRA_CA_CERTS=../certs/localhost.crt
