#!/usr/bin/env python3
"""コミット時に `CLAUDE.md` → **Test-First Implementation** を強制する git フック。

Claude Code のフック(.claude/hooks/guard.py)はエージェントの操作しか見られないため、
コミットという不変条件はここでも検査する。人手のコミットにも等しく効く。

検査するもの:
  1. フェーズ分離 — テストコードとプロダクションコードを同じコミットに入れない
  2. テストの黙殺 — @Disabled / test.skip などを追加しない
     (マージコミットでは、1 は免除、2 は MERGE_HEAD 側に既にある記述に限り免除、
     5 は免除しない — #1125、#1452)
  3. テストファースト — プロダクションコードのコミットより前に、
     このブランチにテストコードの変更が存在すること
  4. `apps/web` のリポジトリ全体カバレッジ床 — apps/web に触れるコミットに限り
     `npm run test:coverage` を走らせる(#1040)
  5. 未分類パスの拒否 — `.claude/hooks/paths.py` がテスト/プロダクション/宣言済み中立の
     どれにも分類しないパスのコミットを拒否する(#1452)

このスクリプトは `git commit` と、コンフリクトを解決した後の明示コミットしか拾わない —
git はコミット経路ごとに別のフックを起動するため(`man githooks`)、**コンフリクトなしの
`git merge`(= 最も普通の結果)はこのスクリプトを一切通らない**。その経路は
`scripts/git-hooks/pre-merge-commit` が別途拾い、上記5だけを検査する。理由と、
2・4 をそちらへ委譲しない理由は同スクリプトの docstring を参照。

有効化(`core.hooksPath` はディレクトリ単位なので、このスクリプトと
`pre-merge-commit` は同時に束縛される):
    git config core.hooksPath scripts/git-hooks
"""

import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
REPO_ROOT = os.path.abspath(os.path.join(HERE, "..", ".."))
sys.path.insert(0, os.path.join(HERE, "..", "..", ".claude", "hooks"))
from paths import classify, is_declared_neutral, is_production, is_test  # noqa: E402
from silencers import SILENCERS  # noqa: E402

# apps/web のリポジトリ全体カバレッジ床(#1040)。`apps/web/jest.config.ts` の
# `coverageThreshold.global` は「レガシーコードのための床」で、下げてはならないと
# CLAUDE.md → Test-First Implementation → Coverage が明記している。ところが
# `npm run test:coverage` を手で叩かない限り、床を割った状態は誰にも気づかれない
# (#1040 本文が示した、統計もテストも全緑なのに閾値だけ非0で終わる状態)。
# `scripts/check-changed-coverage.py`(このIssueが変更した行のC1/C2、90%基準)とは
# 別の指標・別のスクリプトである — そちらは変更しない(#1040 の Out of Scope)。
WEB_PATTERN = re.compile(r"^apps/web/")

RED = "\033[31m"
OFF = "\033[0m"


def run(args):
    out = subprocess.run(args, capture_output=True, text=True)
    return out.stdout if out.returncode == 0 else None


def fail(title, body):
    print("%s✗ %s%s\n" % (RED, title, OFF))
    print(body)
    print("\n(この検査は CLAUDE.md の規約を強制するものです。--no-verify で回避しないこと。)")
    sys.exit(1)


def git_paths(args):
    """パスを出力する git コマンドの結果を、パス引用(core.quotePath)なしの実パスで返す(#1457)。

    git は既定で非ASCIIパスを `"docs/\\350..."` の形で出力し、分類規則に合致しなくなる。
    `-z` の NUL 区切りで読めば、引用も改行を含む名前も問題にならない。
    """
    out = run(["git", "-c", "core.quotePath=false"] + args + ["-z"]) or ""
    return [p for p in out.split("\0") if p]


def staged_files():
    return git_paths(["diff", "--cached", "--name-only", "--diff-filter=ACMR"])


def merge_in_progress():
    """マージコミットを作成中(`MERGE_HEAD` あり)なら True(#1125)。

    マージコミットでは `git diff --cached` が HEAD との差分、つまり取り込む側の全コミット分を
    返す。CLAUDE.md → Merge Conflicts が許す「衝突解決コミットは機械的な突き合わせ」という
    例外を実装に反映するための判定。
    """
    return run(["git", "rev-parse", "-q", "--verify", "MERGE_HEAD"]) is not None


def check_phase_separation(files):
    if merge_in_progress():
        return
    tests, prod = classify(files)
    if tests and prod:
        fail(
            "テストコードとプロダクションコードが同じコミットに混在しています",
            "テスト:\n  %s\n\nプロダクション:\n  %s\n\n"
            "フェーズは交互に、別々のコミットにしてください:\n"
            "  git restore --staged <片側のパス>\n"
            "  git commit -m 'test: ...'   # テストフェーズ\n"
            "  git commit -m 'feat: ...'   # プロダクションフェーズ"
            % ("\n  ".join(tests), "\n  ".join(prod)),
        )


def check_unclassified(files, merging=None):
    """`paths.py` の3分類(テスト/プロダクション/宣言済み中立)のどれにも
    当たらないパスのコミットを拒否する(#1452)。

    `.claude/hooks/test_paths.py` の `RepositoryExhaustiveness` は同じ不変条件を
    `develop` に取り込まれた後に事後検査するが、直下にスクリプトが増えるたびに
    develop がそのとき初めて赤くなる再発が繰り返された(#1208 → #1321 → #1452)。
    ここでコミット時点で止めることで、CLAUDE.md → 「ちょうど1つ」の強制が2層で
    ある理由 と同じ構成(事前のフックと事後の単体テストの2層)にする。

    マージコミットは免除しない。`check_phase_separation` がマージコミットを
    免除する(#1125)のは、マージでは取り込む側の全コミット分の差分に
    テストとプロダクションが混在するのが構造的に正常だからである。未分類パスは
    事情が異なる — マージで未分類パスが取り込まれることは正常な事象ではなく、
    まさにこの検査が閉じようとしている欠陥そのものであるため、免除すると
    ローカルでの衝突解決マージ(CLAUDE.md → Merge Conflicts)が同じ抜け道に
    なってしまう。詳細: `docs/WORKFLOW_RULE_RATIONALE.md` → Unclassified path rejection。

    この免除しない判断が詰みにならない前提(同じコミットに新ファイルと分類を足せば
    解決できること)は、フックが**コミットする側の** worktree から `paths.py` を
    読むことに依存する。これは `core.hooksPath` が現在**相対値**
    (`scripts/git-hooks`)であるためで、絶対パスに切り替えると linked worktree は
    自分自身の `paths.py` を分類に使えなくなる(#1319、未解決)。

    `merging` は「マージコミットか」を明示的に渡すための引数で、省略時(`None`)は
    `merge_in_progress()`(`MERGE_HEAD` の有無)で判定する — このスクリプトが
    `git commit` から呼ばれる通常の経路。`scripts/git-hooks/pre-merge-commit` は
    `merging=True` を明示的に渡す。これは省略できない: `pre-merge-commit` フックは
    「マージが自動で成立した後、コミットを作る前」に実行され、この時点では
    まだ `MERGE_HEAD` が書かれていない(`man githooks`、および実測)。
    `merge_in_progress()` に頼ると、まさにこの経路でマージ用ヒントが常に欠落する。
    呼び出し元(`pre-merge-commit`)は自分がマージ経路であることを文脈上知っているので、
    それをそのまま渡す。
    """
    if merging is None:
        merging = merge_in_progress()
    unclassified = [
        p for p in files if not (is_test(p) or is_production(p) or is_declared_neutral(p))
    ]
    if unclassified:
        hint = ""
        if merging:
            hint = (
                "\n\nマージコミットです。CLAUDE.md → Merge Conflicts の下で許される通り、"
                "この同じコミットに上記パスの分類(paths.py への追記)を足せば解決できます"
                "(免除ではなく、衝突解決コミットとして分類を含めてください)。"
            )
        fail(
            "テスト / プロダクション / 中立のいずれにも分類されていないパスがあります",
            "  %s\n\n"
            "`.claude/hooks/paths.py` の TEST_PATTERNS / PRODUCTION_PATTERNS / "
            "NEUTRAL_PATTERNS のいずれかに追加し、分類の根拠をコメントに書いてください。"
            "(黙って中立に落ちるファイルを防ぐための検査です。#983、#1452)"
            "%s"
            % ("\n  ".join(unclassified), hint),
        )


def present_in_merge_head(path, pattern):
    """`MERGE_HEAD` 側の同じパスに既に黙殺パターンがあれば True(継承した記述)。"""
    content = run(["git", "show", "MERGE_HEAD:%s" % path]) or ""
    return re.search(pattern, content) is not None


def check_silencers(files):
    merging = merge_in_progress()
    for path in files:
        if not (is_test(path) or is_production(path)):
            continue
        diff = run(["git", "diff", "--cached", "-U0", "--", path]) or ""
        added = "\n".join(l[1:] for l in diff.splitlines() if l.startswith("+") and not l.startswith("+++"))
        for pattern, label in SILENCERS:
            if re.search(pattern, added):
                if merging and present_in_merge_head(path, pattern):
                    continue
                fail(
                    "テストを黙らせる変更が含まれています: %s (%s)" % (label, path),
                    "失敗しているテストは直すものであって、skip / ignore / 削除するものではありません。\n"
                    "まずプロダクションコードを修正してください。テストケース自体が不適切だと\n"
                    "示せる場合に限りテストを修正し、その理由を報告すること。",
                )


def base_ref():
    for ref in ("origin/develop", "develop"):
        if run(["git", "rev-parse", "--verify", "--quiet", ref]):
            return ref
    return None


def check_test_first(files):
    _, prod = classify(files)
    if not prod:
        return
    base = base_ref()
    if base is None:
        return
    merge_base = (run(["git", "merge-base", base, "HEAD"]) or "").strip()
    if not merge_base:
        return
    branch_files = git_paths(["diff", "--name-only", merge_base, "HEAD"])
    if any(is_test(p) for p in branch_files):
        return
    fail(
        "テストより先にプロダクションコードをコミットしようとしています",
        "このブランチにはまだテストコードの変更が1つもありません。\n\n"
        "プロダクション:\n  %s\n\n"
        "受け入れ基準を Gherkin シナリオ(apps/web/e2e/features/**/*.feature)に翻訳し、\n"
        "失敗することを確認してから実装してください(CLAUDE.md → Test-First Implementation)。\n"
        "  cd apps/web && npm run test:at:fast" % "\n  ".join(prod),
    )


def touches_web(files):
    return any(WEB_PATTERN.match(p) for p in files)


def committing_worktree_root():
    """このコミットが実際に行われている worktree のトップレベルを返す(#1040 QA FAIL)。

    `REPO_ROOT` は `pre-commit` スクリプト自身の物理配置(`__file__`)から導出しているため、
    `core.hooksPath` がメイン作業ツリーの絶対パスを指す構成(このリポジトリの実環境)では、
    linked worktree からコミットしても常にメイン作業ツリーの物理ファイルが実行され、
    `__file__` は常にメインを指す。git がフックを起動する時の cwd は、コミットが実際に
    行われている worktree のトップレベルに設定される(メイン・linked のどちらでも)ため、
    `git rev-parse --show-toplevel` をデフォルトの cwd(= 呼び出し元プロセスの cwd)で実行す
    れば、常に「このコミットの worktree」を得られる。取得できない場合は `REPO_ROOT` に
    フォールバックする。
    """
    out = (run(["git", "rev-parse", "--show-toplevel"]) or "").strip()
    return out or REPO_ROOT


def check_web_coverage_floor(files):
    """apps/web を触るコミットに限り `npm run test:coverage` を走らせ、床割れを検知する(#1040)。

    services/**・packages/** だけを触るコミットで毎回 jest のフルカバレッジ実行
    (実測20秒超)を課さないよう、apps/web に触れていない限り一切実行しない
    (#1040 が明示した要求)。
    """
    if not touches_web(files):
        return
    web_dir = os.path.join(committing_worktree_root(), "apps", "web")
    if not os.path.isfile(os.path.join(web_dir, "package.json")):
        # apps/web が実際の npm プロジェクトでない(このリポジトリでは常に存在するが、
        # 他のフック検査を単体テストする際の使い捨てリポジトリ雛形にはそもそも無い)。
        # その場合は判定対象がないので黙って抜ける — フェーズ分離等の他の検査には無関係。
        return
    result = subprocess.run(
        ["npm", "run", "test:coverage"],
        cwd=web_dir,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        output = (result.stdout + result.stderr).strip()
        # 依存未導入(新規 linked worktree 等)は npm も非0で終了するが、カバレッジは
        # 1行も測っていない。「床割れ」と誤診断せず、通さないまま原因を正しく伝える(#1320)。
        if not os.path.isdir(os.path.join(web_dir, "node_modules")) or any(
            sig in output for sig in ("jest: not found", "command not found")
        ):
            fail(
                "apps/web の依存パッケージが未導入のため、カバレッジ床を検査できません",
                "cd apps/web && npm run test:coverage が非0で終了しました:\n\n%s\n\n"
                "カバレッジは測定されていません(床割れではありません)。このworktreeの "
                "apps/web で `npm install`(または `npm ci`)を実行してから、"
                "再度コミットしてください。" % output[-4000:],
            )
        fail(
            "apps/web のリポジトリ全体カバレッジ床(jest.config.ts の coverageThreshold)を"
            "下回っています",
            "cd apps/web && npm run test:coverage が非0で終了しました:\n\n%s\n\n"
            "テストを追加して床(40%%)を回復してください。閾値そのものを下げる場合は、"
            "CLAUDE.md → Test-First Implementation → Coverage の記述を根拠とともに"
            "書き換える、独立した判断として行うこと(安易に下げないこと)。"
            % (result.stdout + result.stderr).strip()[-4000:],
        )


def main():
    files = staged_files()
    if not files:
        return 0
    check_phase_separation(files)
    check_unclassified(files)
    check_silencers(files)
    check_test_first(files)
    check_web_coverage_floor(files)
    return 0


if __name__ == "__main__":
    sys.exit(main())
