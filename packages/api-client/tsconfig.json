{
  // issue #810: sdk/api-client 自体の型チェック用。
  //
  // これが無いと、web の型チェック(path mapping 経由)が index.ts から到達できるファイルしか
  // 見ないため、index.ts から再エクスポートされていない生成物はどのビルドでも型検査されない。
  // include でディレクトリを指定し、到達可能性に関係なく src 配下を全て対象にする。
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    // Headers.entries() を使う生成コードがあるため DOM.Iterable が要る。
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
