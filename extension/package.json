{
  "name": "letsblog-vscode",
  "displayName": "Let's Blog",
  "description": "Markdownで執筆した記事を仲介APIサーバー経由でWordPressへ投稿するVSCode拡張",
  "version": "0.2.6",
  "publisher": "letsblog",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "letsBlog.login",
        "title": "Let's Blog: Login"
      },
      {
        "command": "letsBlog.publish",
        "title": "Let's Blog: Publish"
      },
      {
        "command": "letsBlog.deletePost",
        "title": "Let's Blog: Delete Post"
      },
      {
        "command": "letsBlog.selectSite",
        "title": "Let's Blog: Select Site"
      },
      {
        "command": "letsBlog.setApiKey",
        "title": "Let's Blog: Set API Key"
      },
      {
        "command": "letsBlog.askAi",
        "title": "Let's Blog: Ask AI (Draft/Proofread/Summarize)"
      },
      {
        "command": "letsBlog.suggestTags",
        "title": "Let's Blog: Suggest Tags"
      },
      {
        "command": "letsBlog.generateImage",
        "title": "Let's Blog: Generate Image"
      },
      {
        "command": "letsBlog.generateSection",
        "title": "Let's Blog: Generate Section"
      },
      {
        "command": "letsBlog.selectProject",
        "title": "Let's Blog: Select Project"
      },
      {
        "command": "letsBlog.planArticle",
        "title": "Let's Blog: Plan Article"
      },
      {
        "command": "letsBlog.previewArticle",
        "title": "Let's Blog: Preview Article"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "letsBlog.generateImage",
          "when": "editorTextFocus && resourceLangId == markdown",
          "group": "letsBlog@1"
        },
        {
          "command": "letsBlog.generateSection",
          "when": "editorTextFocus && resourceLangId == markdown",
          "group": "letsBlog@2"
        }
      ]
    },
    "configuration": {
      "title": "Let's Blog",
      "properties": {
        "letsBlog.serverUrl": {
          "type": "string",
          "default": "https://localhost",
          "description": "仲介APIサーバーのベースURL(リバースプロキシ経由の自己署名証明書を既定で使用)"
        },
        "letsBlog.allowInsecureTls": {
          "type": "boolean",
          "default": false,
          "description": "letsBlog.serverUrlへのHTTPS接続で自己署名証明書を許容する(証明書検証をスキップする)。既定はfalse(検証を行う)。自己署名証明書のローカル環境(https://localhost等)へ接続する場合のみ、接続先が信頼できることを確認したうえでtrueに設定してください。trueにすると中間者攻撃を検出できなくなります。"
        },
        "letsBlog.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "デバッグログを出力パネル「Let's Blog」へ出力する。不具合の調査時に有効化してください。"
        },
        "letsBlog.requestTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "description": "APIリクエストのタイムアウト時間(ミリ秒)。AI生成など時間のかかる処理でタイムアウトする場合は延ばしてください。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "generate:api-client": "cd .. && ./scripts/generate-api-client.sh"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "zod": "^4.4.3"
  }
}
