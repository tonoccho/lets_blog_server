# docker-socket-proxy の haproxy 設定(#1587)。
#
# tecnativa/docker-socket-proxy v0.5.0(ダイジェスト固定、docker-compose.yml 参照)の
# /usr/local/etc/haproxy/haproxy.cfg.template のうち、`frontend dockerfrontend` だけを差し替えている。
# それより前の global / defaults / backend と、末尾の use_backend はイメージのものと同一。
# イメージを更新するときは、イメージ内の同ファイルと差分を取って追随すること:
#   docker run --rm --entrypoint cat <image> /usr/local/etc/haproxy/haproxy.cfg.template
#
# 差し替えた理由: イメージ既定の frontend は先頭で `deny unless METH_GET || env(POST)` と全 POST を
# 拒否してから ALLOW_START / ALLOW_STOP を評価するため、POST=0 では start / stop も通らず、
# POST=1 では create / exec / restart / kill まで通る。許すものを列挙する形にすれば、
# 環境変数の評価順に左右されない。
#
global
    log stdout format raw daemon "${LOG_LEVEL}"

    pidfile /run/haproxy.pid
    maxconn 4000

    # Turn on stats unix socket
    server-state-file /var/lib/haproxy/server-state

defaults
    mode http
    log global
    option httplog
    option dontlognull
    option http-server-close
    option redispatch
    retries 3
    timeout http-request 10s
    timeout queue 1m
    timeout connect 10s
    timeout client 10m
    timeout server 10m
    timeout http-keep-alive 10s
    timeout check 10s
    maxconn 3000

    # Allow seamless reloads
    load-server-state-from-file global

    # Use provided example error pages
    errorfile 400 /usr/local/etc/haproxy/errors/400.http
    errorfile 403 /usr/local/etc/haproxy/errors/403.http
    errorfile 408 /usr/local/etc/haproxy/errors/408.http
    errorfile 500 /usr/local/etc/haproxy/errors/500.http
    errorfile 502 /usr/local/etc/haproxy/errors/502.http
    errorfile 503 /usr/local/etc/haproxy/errors/503.http
    errorfile 504 /usr/local/etc/haproxy/errors/504.http

backend dockerbackend
    server dockersocket $SOCKET_PATH

backend docker-events
    server dockersocket $SOCKET_PATH
    timeout server 0

frontend dockerfrontend
    bind ${BIND_CONFIG}

    # ダッシュボードのコンテナ一覧と、停止中コンテナの終了コード判定(ContainerStatusService)。
    http-request allow if METH_GET { path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/json$ }
    http-request allow if METH_GET { path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/[a-zA-Z0-9_.-]+/json$ }
    # コンテナの起動・停止だけ(#1399)。restart / kill / pause / exec / create / DELETE は許さない。
    http-request allow if { method POST } { path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/[a-zA-Z0-9_.-]+/(start|stop)$ }
    http-request deny
    default_backend dockerbackend

    use_backend docker-events if { path,url_dec -m reg -i ^(/v[\d\.]+)?/events }
